{
    "api_path": {
        "description": "API接口路径",
        "type": "string",
        "default": "/api/render/image"
    },
    "auth_token": {
        "description": "认证令牌 (可选，用于API安全认证)",
        "type": "string",
        "default": ""
    },
    "server_host": {
        "description": "HTTP服务监听地址",
        "type": "string",
        "default": "0.0.0.0"
    },
    "server_port": {
        "description": "HTTP服务端口",
        "type": "int",
        "default": 11451
    },
    "render_quality": {
        "description": "默认渲染质量（low/medium/high/ultra，映射 72/144/200/300 PPI）",
        "type": "string",
        "default": "high"
    },
    "templates": {
        "description": "自定义模板（JSON 格式：{\"别名\": {\"name\": \"...\", \"description\": \"...\", \"typ_content\": \"...\", \"render_quality\": \"high\"}}）",
        "type": "string",
        "default": "{}",
        "editor_mode": true,
        "editor_language": "json"
    }
}